{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dmh:database:1",
  "title": "Dead Mans Hunt database tables",
  "type": "object",
  "required": [
    "categories",
    "config",
    "experiments",
    "observations",
    "routes",
    "sources",
    "theories",
    "theory_experiments",
    "theory_routes",
    "interpretations",
    "questions",
    "interpretation_groups",
    "interpretation_angles",
    "legacy_interpretations",
    "breakdowns",
    "riddles"
  ],
  "additionalProperties": false,
  "properties": {
    "categories": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/categories"
      }
    },
    "config": {
      "type": "object",
      "description": "Settings and allowed editorial/evidence/testing labels"
    },
    "experiments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/experiments"
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observations"
      }
    },
    "routes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/routes"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sources"
      }
    },
    "theories": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/theories"
      }
    },
    "theory_experiments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/theory_experiments"
      }
    },
    "theory_routes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/theory_routes"
      }
    },
    "interpretations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/interpretations"
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/questions"
      }
    },
    "interpretation_groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/interpretation_groups"
      }
    },
    "interpretation_angles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/interpretation_angles"
      }
    },
    "legacy_interpretations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/legacy_interpretations"
      }
    },
    "breakdowns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/breakdowns"
      }
    },
    "riddles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/riddles"
      }
    }
  },
  "$defs": {
    "categories": {
      "type": "object",
      "required": [
        "id",
        "name",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "experiments": {
      "type": "object",
      "required": [
        "id",
        "title",
        "route_ids",
        "source_ids",
        "stage",
        "procedure",
        "conditions",
        "result",
        "testing_label",
        "evidence_label",
        "date",
        "author",
        "limitations"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^E[0-9]{3}$"
        },
        "title": {
          "type": "string"
        },
        "route_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stage": {
          "type": [
            "string",
            "null"
          ]
        },
        "procedure": {
          "type": "string"
        },
        "conditions": {
          "type": [
            "string",
            "null"
          ]
        },
        "result": {
          "type": [
            "string",
            "null"
          ]
        },
        "testing_label": {
          "type": "string",
          "enum": [
            "Not tested",
            "Partially tested",
            "Tested negative under specified conditions",
            "Inconclusive",
            "Verified positive result"
          ]
        },
        "evidence_label": {
          "type": "string",
          "enum": [
            "Confirmed",
            "Observed",
            "Reported",
            "Interpretation",
            "Unverified"
          ]
        },
        "date": {
          "type": [
            "string",
            "null"
          ]
        },
        "author": {
          "type": [
            "string",
            "null"
          ]
        },
        "limitations": {
          "type": "string"
        },
        "previous_route_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mapping_note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "observations": {
      "type": "object",
      "required": [
        "id",
        "label",
        "text",
        "source_ids",
        "limitation",
        "last_reviewed"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^O[0-9]{3}$"
        },
        "label": {
          "type": "string",
          "enum": [
            "Confirmed",
            "Observed",
            "Reported",
            "Interpretation",
            "Unverified"
          ]
        },
        "text": {
          "type": "string"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limitation": {
          "type": "string"
        },
        "last_reviewed": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "routes": {
      "type": "object",
      "required": [
        "id",
        "title",
        "category",
        "source_row",
        "source_url",
        "original_description",
        "original_evidence_label",
        "original_testing_label",
        "original_gap",
        "original_source_text",
        "original_group_hint"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(R[0-9]{3}|N[0-9]{3})$"
        },
        "title": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "source_row": {
          "type": "integer"
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "original_description": {
          "type": "string"
        },
        "original_evidence_label": {
          "type": "string"
        },
        "original_testing_label": {
          "type": "string"
        },
        "original_gap": {
          "type": "string"
        },
        "original_source_text": {
          "type": "string"
        },
        "original_group_hint": {
          "type": "string"
        },
        "website_note": {
          "type": "string"
        },
        "website_source_url": {
          "type": "string",
          "format": "uri"
        },
        "description": {
          "type": "string"
        },
        "evidence_label": {
          "type": "string"
        },
        "testing_label": {
          "type": "string"
        },
        "gap": {
          "type": "string"
        },
        "group_hint": {
          "type": "string"
        },
        "last_reviewed": {
          "type": "string"
        },
        "mapping_note": {
          "type": "string"
        },
        "background_urls": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "previously_published": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "object",
      "required": [
        "id",
        "title",
        "url",
        "kind",
        "author",
        "date",
        "limitation",
        "visibility"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^S[0-9]{3}$"
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "kind": {
          "type": "string"
        },
        "author": {
          "type": [
            "string",
            "null"
          ]
        },
        "date": {
          "type": [
            "string",
            "null"
          ]
        },
        "limitation": {
          "type": "string"
        },
        "visibility": {
          "type": "string",
          "enum": [
            "public",
            "private"
          ]
        }
      },
      "additionalProperties": false
