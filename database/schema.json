    "theories": {
      "type": "object",
      "required": [
        "id",
        "title",
        "status",
        "publication_state"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^T[0-9]{3}$"
        },
        "title": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "Active",
            "Watchlist",
            "Parked",
            "Needs verification",
            "Retired",
            "Resolved",
            "Merged / Superseded",
            "Reference only"
          ]
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scope": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "origin": {
          "type": "string"
        },
        "supports": {
          "type": "array"
        },
        "against": {
          "type": "array"
        },
        "assessment": {
          "type": "string"
        },
        "change_my_mind": {
          "type": "string"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "last_reviewed": {
          "type": "string"
        },
        "testing_label": {
          "type": "string",
          "enum": [
            "Not tested",
            "Partially tested",
            "Tested negative under specified conditions",
            "Inconclusive",
            "Verified positive result"
          ]
        },
        "next_experiment": {
          "type": [
            "object",
            "null"
          ]
        },
        "parking": {
          "type": [
            "object",
            "null"
          ]
        },
        "featured": {
          "type": "boolean"
        },
        "publication_state": {
          "type": "string",
          "enum": [
            "developed",
            "planned"
          ]
        },
        "retirement_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "superseded_by": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^T[0-9]{3}$"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "publication_state": {
                "const": "developed"
              }
            },
            "required": [
              "publication_state"
            ]
          },
          "then": {
            "required": [
              "title",
              "summary",
              "origin",
              "categories",
              "scope",
              "status",
              "supports",
              "against",
              "assessment",
              "change_my_mind",
              "source_ids",
              "last_reviewed",
              "testing_label"
            ]
          }
        }
      ]
    },
    "theory_experiments": {
      "type": "object",
